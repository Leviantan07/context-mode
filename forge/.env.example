# Copy to .env and fill in.

# --- API / worker ---
PORT=8787
HOST=0.0.0.0
DATABASE_URL=postgres://forge:forge@localhost:5432/forge

# Absolute path to the repo the worker runs Claude Code against.
# V1 uses one fixed repo for every task — see task-manager.ts.
FORGE_REPO_PATH=/absolute/path/to/your/repo

# --- Claude Code (via @anthropic-ai/claude-agent-sdk) ---
# Auth: the SDK resolves credentials the same way the Anthropic SDKs do
# (ANTHROPIC_API_KEY, or an `ant auth login` profile). Set one.
ANTHROPIC_API_KEY=

CLAUDE_CODE_MODEL=sonnet

# acceptEdits (default, safer) or bypassPermissions (full autonomy — only
# inside an isolated container with no access to secrets/networks it
# shouldn't reach). See docs/ARCHITECTURE.md -> Permission mode.
CLAUDE_CODE_PERMISSION_MODE=acceptEdits

# --- LangSmith (optional — unset disables tracing, Postgres metrics still work) ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=forge
